{
  "name": "micro-crm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "format": "prettier --write src/features/invoices/InvoiceDocument.tsx src/features/invoices/InvoiceForm.tsx src/features/invoices/InvoicesPage.tsx tests/Invoices.test.tsx",
    "format:check": "prettier --check src/features/invoices/InvoiceDocument.tsx src/features/invoices/InvoiceForm.tsx src/features/invoices/InvoicesPage.tsx tests/Invoices.test.tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^27.0.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vitest": "5.0.5"
  }
}
